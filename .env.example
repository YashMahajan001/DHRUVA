# Environment Configuration for SIH26054 Digital Twin UAV

# Backend / API Settings
PROJECT_NAME="SIH26054 Digital Twin UAV"
API_V1_STR="/api"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Settings (PostgreSQL default, falls back to SQLite if PostgreSQL is unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_twin_uav
SQLITE_FALLBACK_URL=sqlite:///./digital_twin_uav.db

# MQTT Broker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=uav/+/telemetry

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# Security
SECRET_KEY=sih26054-digital-twin-uav-secret-key-super-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440
