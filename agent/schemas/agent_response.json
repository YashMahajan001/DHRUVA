{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DhruvaAgentResponse",
  "description": "Schema for structured responses generated by the DHRUVA AI Engineering Copilot Agent",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error", "warning"]
    },
    "intent": {
      "type": "string",
      "description": "Classified intent such as engine_diagnosis, mission_readiness, fleet_comparison, throttle_analysis, tuning_evaluation, rul_assessment, maintenance_advisory, general_query"
    },
    "engine_id": {
      "type": "string",
      "description": "Identifier of the primary engine evaluated (e.g., ENG 01, ENG 03, FLEET)"
    },
    "decision_status": {
      "type": "string",
      "description": "High-level status badge (e.g., REVIEW REQUIRED, NOT RECOMMENDED, OPTIMAL, CONDITIONAL, HIGH PRIORITY)"
    },
    "health_score": {
      "type": "number",
      "description": "Health index out of 100"
    },
    "primary_finding": {
      "type": "string",
      "description": "Single concise sentence stating primary diagnostic finding"
    },
    "summary": {
      "type": "string",
      "description": "Summary of the diagnostic finding"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of key diagnostic findings"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Grounded quantitative telemetry or digital twin evidence points"
    },
    "evidence_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "delta": { "type": "string" },
          "status": { "type": "string", "enum": ["nominal", "warning", "critical"] }
        },
        "required": ["label", "value"]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Analytical confidence score"
    },
    "mission_impact": {
      "type": "string",
      "description": "Estimated impact on current or planned mission profiles"
    },
    "recommendation": {
      "type": "string",
      "description": "Actionable engineering advice or inspection guidance"
    },
    "why_this_alert": {
      "type": "object",
      "properties": {
        "factors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conclusion": { "type": "string" }
      },
      "required": ["factors", "conclusion"]
    },
    "correlated_signals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of data signals correlated (e.g. Telemetry, Health, Faults, RUL, Mission, Fleet)"
    },
    "reasoning_chain": {
      "type": "object",
      "properties": {
        "observation": {
          "type": "string",
          "description": "Current state observation"
        },
        "evidence": {
          "type": "string",
          "description": "Key telemetry measurements and deviations vs baseline"
        },
        "analysis": {
          "type": "string",
          "description": "Physics and digital twin analytical assessment"
        },
        "recommendation": {
          "type": "string",
          "description": "Engineering recommendation"
        },
        "envelope": {
          "type": "string",
          "description": "Operational flight envelope status"
        }
      },
      "required": ["observation", "evidence", "analysis", "recommendation", "envelope"]
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of diagnostic tools executed to fulfill the request"
    },
    "data_mode": {
      "type": "string",
      "enum": ["DEMO", "LIVE", "DEMO ANALYTICS", "DEMO ESTIMATE", "DEMO SIMULATION"],
      "default": "DEMO ANALYTICS"
    }
  },
  "required": [
    "status",
    "intent",
    "engine_id",
    "summary",
    "findings",
    "evidence",
    "confidence",
    "mission_impact",
    "recommendation",
    "reasoning_chain",
    "tools_used",
    "data_mode"
  ]
}
