{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dhruva.local/schemas/telemetry_message.json",
  "title": "DHRUVA Canonical Telemetry Message",
  "description": "Schema for one telemetry reading matching the backend integration contract. Exactly 8 fields, no extras.",
  "type": "object",
  "required": [
    "engine_id",
    "timestamp",
    "rpm",
    "temperature",
    "oil_pressure",
    "fuel_flow",
    "altitude",
    "throttle"
  ],
  "properties": {
    "engine_id": {
      "type": "string",
      "description": "Unique engine instance identifier (e.g. ENG001)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of this reading."
    },
    "rpm": {
      "type": "number",
      "minimum": 0,
      "description": "Engine revolutions per minute."
    },
    "temperature": {
      "type": ["number", "null"],
      "description": "Engine temperature in deg C. May be null during sensor dropout."
    },
    "oil_pressure": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Engine oil pressure in psi. May be null during sensor dropout."
    },
    "fuel_flow": {
      "type": ["number", "null"],
      "description": "Fuel flow rate in L/h. May be null during sensor dropout."
    },
    "altitude": {
      "type": "number",
      "minimum": 0,
      "description": "Altitude in metres above sea level."
    },
    "throttle": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Throttle position 0-100%."
    }
  },
  "additionalProperties": false
}
